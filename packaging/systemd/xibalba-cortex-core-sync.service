[Unit]
Description=Sync finalized CORE agent registrations into Cortex
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/xibalba-cortex/core-sync.env
# Run from the checked-out sibling repository so the local integrity-sdk path
# dependency is resolved by uv. The command itself remains fail-closed when
# CORE's snapshot is not finalized.
ExecStart=%h/.local/bin/uv run --project %h/Projects/xibalba-cortex xibalba-cortex-sync-core-registrations
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.hermes/xibalba-cortex
