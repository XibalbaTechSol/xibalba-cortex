# Local Supabase Auth Google provider. Keep real values in the ignored root .env.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Cortex's Python service derives the Auth JWKS URL from this project URL.
SUPABASE_URL=https://ftspunijfgcbkuybobhf.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only Supabase Postgres connection; never expose it to the Vite viewer.
CORTEX_MANAGED_DATABASE_URL=
