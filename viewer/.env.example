# Base URL of the xibalba_cortex.local_api server.
VITE_LOCAL_API_URL=http://localhost:8420

# Bearer token for local_api (required -- it fails closed with no default).
# Issue one with: uv run xibalba-cortex-ingest-tokens --home <profile-home> issue --label viewer --role reader
# Use --role writer instead if you use the viewer's write actions (e.g. "Build Exchanges").
VITE_LOCAL_API_TOKEN=
